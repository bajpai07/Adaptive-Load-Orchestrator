# ==============================================================================
# ADAPTIVE LOAD ORCHESTRATOR — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env or configure these variables in Railway / Render settings.

# ------------------------------------------------------------------------------
# 1. HTTP SERVER PORT
# ------------------------------------------------------------------------------
# Automatically assigned by Railway / Render at container runtime.
# Defaults to 8081 if unset.
PORT=8081

# ------------------------------------------------------------------------------
# 2. REDIS DATABASE CONNECTION
# ------------------------------------------------------------------------------
# Set REDIS_URL for full connection strings (e.g. Railway Redis plugin or Redis Cloud).
# Format: redis://:<password>@<host>:<port>/<db>
# REDIS_URL=redis://default:secret_password@redis.railway.internal:6379/0

# Alternatively, set REDIS_ADDR if using a standard host:port string without URL scheme.
# REDIS_ADDR=127.0.0.1:6379

# NOTE: If neither REDIS_URL nor REDIS_ADDR is set, the application automatically
# falls back to an embedded in-memory Miniredis instance for zero-dependency local testing.

# ------------------------------------------------------------------------------
# 3. SIMULATION & DECISION ENGINE MODE
# ------------------------------------------------------------------------------
# Engine Mode options:
#   - full-orchestration : Group Cart consolidation + Cost-gated re-routing (Phase 4 complete engine)
#   - cost-gated         : Cost-gated cross-store re-routing only (Phase 3 engine)
#   - naive              : Load-based capacity re-routing without cost gate (Phase 1 baseline)
MODE=full-orchestration

# Time Speedup Scale factor (e.g. 100.0 means 10 simulated minutes complete in 6 seconds)
TIME_SCALE=100.0

# ------------------------------------------------------------------------------
# 4. CONTINUOUS LIVE DEMO MODE (RAILWAY / RENDER DEPLOYMENT)
# ------------------------------------------------------------------------------
# Keeps the simulation looping indefinitely so live deployment links never go "down"
# or show "simulation ended". Defaults to true when PORT env var is present.
AUTO_RESTART=true

